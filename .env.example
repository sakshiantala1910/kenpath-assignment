# Claude API key. Without it the app still works and shows rule-based suggestions instead of AI ones.
ANTHROPIC_API_KEY=

# Signs the login cookie. Use a long random string in any shared deployment.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional. Defaults to a local SQLite file (file:./data/app.db), created and seeded on first request.
# For a persistent hosted database, point this at a Turso/libSQL URL and set DATABASE_AUTH_TOKEN.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=
